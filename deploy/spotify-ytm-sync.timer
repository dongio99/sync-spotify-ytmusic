[Unit]
Description=Sync Spotify <-> YouTube Music all'accensione del PC (max una volta al giorno)

[Timer]
# Parte 2 minuti dopo l'avvio (con linger attivo: dall'accensione, anche senza login).
# Il limite di una volta al giorno lo applica lo script con --scheduled.
OnStartupSec=2min

[Install]
WantedBy=timers.target
