[Unit]
Description=Sync playlist Spotify <-> YouTube Music
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/spotify-ytm-sync
# --scheduled: se oggi la sincronizzazione è già riuscita, non fa nulla
ExecStart=%h/spotify-ytm-sync/.venv/bin/python %h/spotify-ytm-sync/sync.py --scheduled
TimeoutStartSec=45min
Nice=10
